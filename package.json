{
  "name": "sensein-cosmetics",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend",
    "admin"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:admin": "npm run dev --workspace admin",
    "dev:client": "npm run dev --workspace frontend",
    "dev:server": "npm run dev --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:admin": "npm run build --workspace admin",
    "build:client": "npm run build --workspace frontend",
    "build": "npm run build:frontend && npm run build:admin",
    "start": "node backend/src/server.js",
    "seed": "npm run seed --workspace backend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend"
  }
}