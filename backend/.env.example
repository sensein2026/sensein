NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sensein
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USER=resend
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=orders@sensein.in
ADMIN_EMAIL=admin@sensein.in

COD_MAX_AMOUNT=5000
FREE_SHIPPING_THRESHOLD=999
DEFAULT_SHIPPING_FEE=79

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Shipping & Logistics
SHIPWAY_USERNAME=your_shipway_username
SHIPWAY_LICENSE_KEY=your_shipway_license_key
SHIPWAY_API_URL=https://app.shipway.com/api/v2orders
