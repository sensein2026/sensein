# ==============================================================================
# SENSEIN E-COMMERCE PLATFORM — ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5001/api

MONGODB_URI=mongodb://127.0.0.1:27017/sensein_ecommerce

JWT_SECRET=super_secret_jwt_encryption_key_minimum_32_characters_long
JWT_REFRESH_SECRET=super_secret_jwt_refresh_encryption_key_minimum_32_characters

RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

DELHIVERY_API_TOKEN=YourDelhiveryAPITokenHere
DELHIVERY_CLIENT_ID=SENSEIN_B2C
DELHIVERY_WAREHOUSE=Sensein Warehouse Surat
DELHIVERY_ORIGIN_PINCODE=395010
DELHIVERY_SANDBOX=true

EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="Sensein Luxury Care <orders@sensein.com>"
ADMIN_EMAIL=admin@sensein.com

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
